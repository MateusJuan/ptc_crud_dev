{
  "name": "treinamento-crud-citi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"ts-node-dev --poll --exit-child -r tsconfig-paths/register --respawn --transpile-only --ignore-watch node_modules --no-notify src/servidor.ts\" \"prisma generate --watch\"",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migration": "cross-env DATABASE_HOST=localhost prisma migrate dev",
    "migration:deploy": "prisma migrate deploy",
    "studio": "cross-env DATABASE_HOST=localhost prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test testes/plantas.teste.mjs",
    "seed": "cross-env DATABASE_HOST=localhost node prisma/popularBanco.mjs",
    "seed:docker": "node prisma/popularBanco.mjs",
    "build": "swc src --strip-leading-paths --out-dir dist",
    "start": "node dist/servidor.js",
    "prod": "yarn migration:deploy && yarn build && yarn start"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.9.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "prisma": "5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
