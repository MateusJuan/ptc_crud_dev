{
  "compilerOptions": {
    "target": "es2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "paths": {
      "@controladores/*": ["./src/controladores/*"],
      "@repositorios/*": ["./src/repositorios/*"],
      "@banco": ["./src/banco/conexao"]
    }
  },
  "include": ["src/**/*"]
}
