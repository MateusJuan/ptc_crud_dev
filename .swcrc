{
  "$schema": "https://swc.rs/schema.json",
  "module": {
    "type": "commonjs"
  },
  "jsc": {
    "parser": {
      "syntax": "typescript"
    },
    "target": "es2020",
    "baseUrl": "./",
    "paths": {
      "@controladores/*": ["./src/controladores/*"],
      "@repositorios/*": ["./src/repositorios/*"],
      "@banco": ["./src/banco/conexao"]
    }
  },
  "minify": true
}
